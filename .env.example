# Portfolio Environment Variables
# Copy this file to .env.local and update values as needed

# Email Configuration (for contact form)
VITE_EMAIL_SERVICE_ID=your_emailjs_service_id
VITE_EMAIL_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAIL_PUBLIC_KEY=your_emailjs_public_key

# GitHub URL
VITE_GITHUB_URL=https://github.com/RishithSuresh

# LinkedIn URL
VITE_LINKEDIN_URL=https://linkedin.com/in/rishithsuresh

# Twitter URL
VITE_TWITTER_URL=https://twitter.com/rishithsuresh

# Website URL
VITE_WEBSITE_URL=https://rishithsuresh.com
